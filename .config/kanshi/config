# Defaults
output "Samsung Display Corp. 0x4193 Unknown" scale 1.5 position 0,0 alias $p14s
# output "Lenovo Group Limited 0x4149 Unknown" scale 1.5 position 0,0 alias $p14s


output "Dell Inc. DELL U3225QE\*" mode 3840x2160@120Hz position 1920,0 alias $dell2

output "Dell Inc.\*" position 1920,0 alias $dell

profile p14s {
  output $p14s
}

# Try first the more specific 120hz config
profile p14s-dell2 {
  output $p14s
  output $dell2
}

# Then any dell
profile p14s-dell {
  output $p14s
  output $dell
}

profile p14s-hdmi {
  output $p14s
  output HDMI-A-1 position 1920,0
}
